# =============================================================================
# AOP — Ajan Tabanlı Operasyon Platformu
# Ortam değişkenleri şablonu.
#
# KULLANIM:
#   cp .env.example .env      (Windows PowerShell: Copy-Item .env.example .env)
#   .env dosyasını doldurun. .env ASLA commit edilmez (.gitignore'da tanımlıdır).
#
# Zorunlu olan tek değişken SAKA_API_KEY'dir. Diğerlerinin kod içinde
# çalışan varsayılanları vardır (src/backend/ai_engine.py).
# =============================================================================

# -----------------------------------------------------------------------------
# 1) SAKA / Turkcell ortak inference gateway kimlik bilgisi  [ZORUNLU]
#    Hem DeepSeek hem Qwen çağrıları bu tek anahtarı kullanır.
#    Anahtar yoksa pipeline çökmeden deterministik moda düşer:
#      - segmentasyon: DEFAULT_FALLBACK_REGEX ile devam eder
#      - RCA: DeterministicRCAEngine sonuçları gösterilir
# -----------------------------------------------------------------------------
SAKA_API_KEY=

# -----------------------------------------------------------------------------
# 2) DeepSeek — segmentasyon ve parser politikası KEŞFİ
#    Sadece bilinmeyen bir log formatı ilk kez görüldüğünde çağrılır.
#    Doğrulanan politika SQLite registry'ye yazılır; sonraki çalıştırmalarda AI=0.
# -----------------------------------------------------------------------------
DEEPSEEK_URL=https://common-inference-apis.turkcelltech.ai/llm-dynamo-deepseek-v4-flash-0731/v1/chat/completions
DEEPSEEK_MODEL_ID=deepseek-v4-flash-0731

# -----------------------------------------------------------------------------
# 3) Qwen — olay/case uzman YORUMU (RCA)
#    Deterministik pipeline'ın ürettiği olay + kanıt paketini yorumlar.
#    Karar üretmez; erişilemezse deterministik RCA aynen korunur.
# -----------------------------------------------------------------------------
QWEN_RCA_URL=https://common-inference-apis.turkcelltech.ai/qwen35-122b-a10b-awq-ai-genai/v1/chat/completions
QWEN_RCA_MODEL_ID=ai-genai__qwen35-122b-a10b-awq-ai-genai

# Yanıt uzunluğu tavanı. Kod bunu 256..1600 aralığına kırpar.
QWEN_RCA_MAX_TOKENS=1400

# Qwen "thinking" modu. Üretimde kapalıdır: JSON şema uyumunu bozar ve
# gecikmeyi ~3x artırır.
QWEN_RCA_ENABLE_THINKING=false
QWEN_RCA_INCLUDE_REASONING=false

# Local/Citrix RCA prompt debugging. Prints the exact system prompt, serialized
# evidence and selected request settings before each RCA HTTP attempt.
# Opt in with 1, true, yes or on (case-insensitive); disabled by default.
# API credentials and HTTP headers are not printed.
RCA_DEBUG=false

# -----------------------------------------------------------------------------
# 4) Doğrulanmış politika registry'sinin konumu  [OPSİYONEL]
#    Segmentasyon ve parser politikaları aynı SQLite dosyasını paylaşır.
#    Boş bırakılırsa: <repo>/data/policy_registry.sqlite3
#    Registry yalnız kompakt politika saklar; ham log, prompt veya AI yanıtı SAKLANMAZ.
# -----------------------------------------------------------------------------
# AIOPS_POLICY_REGISTRY_PATH=./data/policy_registry.sqlite3
